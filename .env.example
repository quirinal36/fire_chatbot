# 국가법령정보 공동활용 API (서버 전용)
API_AUTHKEY=

# OpenRouter (서버 전용)
OPENROUTER_API_KEY=

# OpenAI (서버 전용) — 임베딩. OpenRouter 는 임베딩을 제공하지 않는다. 기획서 §6.1
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Supabase: FireChatbot 프로젝트 (voiiciyuotuyejcoysbh)
# 브라우저에 공개되어도 되는 Publishable key만 NEXT_PUBLIC_ 접두사를 사용한다.
NEXT_PUBLIC_SUPABASE_URL=https://voiiciyuotuyejcoysbh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 Route Handler, Cron, 관리자 작업에서만 사용한다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_URL=https://voiiciyuotuyejcoysbh.supabase.co
SUPABASE_SECRET_KEY=

# API 서버 (server/) — 서버 전용
# 화면 오리진 허용 목록. 쉼표 구분. 개발 환경에서 비우면 http://localhost:5173 을 허용한다.
CORS_ALLOWED_ORIGINS=
# 공유 상위 도메인이 정해지면 `.example.kr` 형태로 넣는다. 비우면 Bearer 토큰만 받는다.
AUTH_COOKIE_DOMAIN=
# /api/diagnostics/* 보호용 임의 문자열. 비우면 진단 경로가 닫힌다.
DIAGNOSTICS_TOKEN=
